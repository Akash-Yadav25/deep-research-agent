# ==============================================================================
# MODEL PROVIDER SELECTION
# Choose ONE active provider: "ollama" | "openai" | "azure_openai" | "bedrock"
# Defaults to "ollama" if omitted.
# ==============================================================================
LLM_PROVIDER=ollama

# Optional per-role provider overrides (defaults to LLM_PROVIDER if unset)
# SUPERVISOR_PROVIDER=azure_openai
# WORKER_PROVIDER=ollama

# ------------------------------------------------------------------------------
# Model Settings
# ------------------------------------------------------------------------------
# Ollama Example:
SUPERVISOR_MODEL=deepseek-r1:14b
SUPERVISOR_TEMPERATURE=0.6
SUPERVISOR_MAX_TOKENS=4096
SUPERVISOR_NUM_CTX=32768
SUPERVISOR_REASONING=true

WORKER_MODEL=qwen3.5:9b
WORKER_TEMPERATURE=0.0
WORKER_MAX_TOKENS=2048
WORKER_NUM_CTX=16384

# OpenAI Example:
# LLM_PROVIDER=openai
# SUPERVISOR_MODEL=gpt-4o
# WORKER_MODEL=gpt-4o-mini

# Azure OpenAI Example:
# LLM_PROVIDER=azure_openai
# SUPERVISOR_MODEL=gpt-4o
# WORKER_MODEL=gpt-4o-mini
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# AWS Bedrock Example:
# LLM_PROVIDER=bedrock
# SUPERVISOR_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# WORKER_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0

# ==============================================================================
# PROVIDER CREDENTIALS & ENDPOINTS
# ==============================================================================

# --- Ollama (Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=15m

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- AWS Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# ==============================================================================
# EXTERNAL SEARCH APIs
# ==============================================================================
# Tavily Search API Key (Get free key at https://tavily.com - 1000 credits/mo)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ==============================================================================
# EXECUTION SETTINGS
# ==============================================================================
MAX_RESEARCH_ITERATIONS=5
ENABLE_SUBTOPICS=false
HEADLESS_MODE=true
