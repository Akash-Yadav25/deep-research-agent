# Tavily Search API Key (Get free key at https://tavily.com - 1000 credits/mo)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Locally deployed models
# Standard dual-model setup:
SUPERVISOR_MODEL=deepseek-r1:14b
WORKER_MODEL=qwen3.5:9b

# Low-end device / laptop single-model recommendation:
# Swapping models takes time, and retaining several large models in memory can
# make the laptop sluggish. Set both to the same model to avoid swapping overhead:
# SUPERVISOR_MODEL=qwen3.5:9b
# WORKER_MODEL=qwen3.5:9b

# Execution Settings
MAX_RESEARCH_ITERATIONS=5
ENABLE_SUBTOPICS=false
HEADLESS_MODE=true
